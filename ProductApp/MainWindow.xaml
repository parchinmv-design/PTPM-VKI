<Window x:Class="ProductApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары" Height="700" Width="1000"
        Background="#f5f5f5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Каталог товаров" FontSize="24" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" Text="Велосипеды • Данные загружены из исходного файла Product.xlsx" FontSize="11" Foreground="#888" Margin="0,0,0,15"/>

        <!-- Фильтры -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Производитель" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#555"/>
            <ComboBox x:Name="ManufacturerFilter" Width="180" SelectionChanged="Filter_Changed"/>

            <TextBlock Text="Поставщик" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#555"/>
            <ComboBox x:Name="SupplierFilter" Width="180" SelectionChanged="Filter_Changed"/>

            <TextBlock Text="Сортировка по скидке" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#555"/>
            <ComboBox x:Name="SortFilter" Width="180" SelectionChanged="SortFilter_Changed">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Сначала большие скидки"/>
                <ComboBoxItem Content="Сначала маленькие скидки"/>
            </ComboBox>

            <Button x:Name="ResetButton" Content="Сбросить" Click="ResetButton_Click"/>
        </StackPanel>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ProductTitle}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SmallLabel}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource FieldValue}">
                                        <Run Text="Производитель: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding ManufacturerId}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource FieldValue}">
                                        <Run Text="Поставщик: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding SupplierId}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource FieldValue}">
                                        <Run Text="Цена: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding Price, StringFormat={}{0:N2} ₽}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource FieldValue}">
                                        <Run Text="Количество на складе: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding WarehouseCount}"/>
                                        <Run Text=" шт."/>
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1" Width="100" Height="60" BorderBrush="#2b2b2b" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Счётчик -->
        <TextBlock x:Name="CountLabel" Grid.Row="4" Text="Найдено товаров: 0" FontSize="11" Foreground="#888" Margin="0,10,0,0"/>
    </Grid>
</Window>
